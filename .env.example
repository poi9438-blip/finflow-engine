# 이 파일을 .env로 복사한 뒤 값을 채우기 (.env는 커밋하지 않음)

# compose 프로젝트 이름 (DB 볼륨을 다른 프로젝트와 분리)
COMPOSE_PROJECT_NAME=finflow-local

MYSQL_DATABASE=finflow
MYSQL_USER=ffuser

# 비밀값: 직접 정한 값으로 바꾸기 (HomeFin과 다른 값으로)
MYSQL_ROOT_PASSWORD=여기에_root_비밀번호
MYSQL_PASSWORD=여기에_ffuser_비밀번호

# HomeFin 서버의 서비스 토큰 서명 키 (HomeFin .env에도 같은 값, 32바이트 이상, HomeFin JWT_SECRET과 다른 값)
SERVICE_TOKEN_SECRET=여기에_32자_이상_서비스_토큰_비밀키

# 운영자 토큰 서명 키 (FinFlow만 앎, 32바이트 이상)
OPERATOR_JWT_SECRET=여기에_32자_이상_운영자_토큰_비밀키

# 연소득·DTI 암호화 키 (정확히 32자, 바꾸면 기존 암호문 복호화 불가)
ENCRYPTION_KEY=여기에_32자_암호화_키

# 첫 운영자 계정 (서버 시작 때 없으면 만듦, 이미 있으면 그대로, 비우면 만들지 않음)
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# 운영자 토큰 유효 기간 (기본 8시간)
# OPERATOR_TOKEN_EXPIRATION_MS=28800000

# 배치: 접수 후 이 기간(일)이 지나도록 심사를 시작하지 않은 신청은 만료 (기본 30)
# APPLICATION_EXPIRE_DAYS=30
# 자동 실행 끄기 (한국 시각 03:00 만료, 03:30 전날 집계, 기본 켜짐)
# BATCH_SCHEDULING_ENABLED=false
